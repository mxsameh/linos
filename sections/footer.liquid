{{ 's-footer.css' | asset_url | stylesheet_tag }}

{% liquid
  assign ig_link = 'https://www.instagram.com/nctrnstudio'
  assign tiktok_link = 'https://www.tiktok.com/@linoskitchenn'
%}

{% comment %}
  <div class="footer__content">
    <p>© {{ 'now' | date: '%Y' }} Your Company Name. All rights reserved.</p>
    <p><a href="{{ shop.url }}/privacy-policy">Privacy Policy</a></p>
    <p><a href="{{ shop.url }}/terms-of-service">Terms of Service</a></p>
  </div>
{% endcomment %}

<footer class="f">
  <div class="f_l">
    <div class="t">
      <div>
        <h4>NAVIGATION</h4>
        <ul>
          <li>
            {{ 'Studio' | link_to: '/about' }}
          </li>
          <li>{{ 'Portfolio' | link_to: '/portfolio' }}</li>
          <li>{{ 'Shop' | link_to: '/shop' }}</li>
        </ul>
      </div>
      <div>
        <h4>TERMS</h4>
        <ul>
          <li>{{ 'Delivery' | link_to: '/contact' }}</li>
          <li>{{ 'Shipping' | link_to: ig_link }}</li>
        </ul>
      </div>
      <div>
        <h4>FOLLOW US</h4>
        <ul>
          <li>{{ 'Instagram' | link_to: ig_link }}</li>
          <li>{{ 'Tiktok' | link_to: tiktok_link }}</li>
        </ul>
      </div>
    </div>
    <div class='b'>
      <span>LINO'S KITCHEN</span>
      <span>LINO'S KITCHEN</span>
    </div>
  </div>
  <div class="f_r">
    <div class="logo">
      {{ 'i-logo.svg' | inline_asset_content }}
    </div>
  </div>

  <div class="f_b">
    <p>nctrn © 20{{ 'now' | date: '%y' }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "footer",
  "settings": []
}
{% endschema %}
