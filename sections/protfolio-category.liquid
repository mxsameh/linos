<script>
  const categories = [
    {% for block in section.blocks %}
      {
        image: {{ block.settings.image | image_url: width: 1200 | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  console.log(categories);
</script>

<div class="category">
  {% for block in section.blocks %}
    <figure>
      <img
        src="{{ block.settings.image | image_url}}"
        width="auto"
        height="auto"
      >
    </figure>
  {% endfor %}

  <div class="cat_h">
    <h2>{{ section.settings.heading }}</h2>
  </div>
</div>

{% schema %}
{
  "name": "portfolio category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "id": "image",
          "label": "Image",
          "type": "image_picker"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portfolio Category"
    }
  ]
}
{% endschema %}
