<script>
  const imgs=[]
  {% for block in section.blocks %}
         const product =
         imgs.push(
         {{ block.settings.image| image_url | json}};
      );
    {% endfor %}
</script>

{% comment %}
  <script>
    const categories = [
      {% for block in section.blocks %}
        {
          image: {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 1200 | json }}
          {% else %}
            null
          {% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ];

    console.log(categories);
  </script>
{% endcomment %}

<div class="category">
  {% for block in section.blocks %}
    <figure>
      <img
        src="{{ block.settings.image | image_url}}"
        width="auto"
        height="auto"
      >
    </figure>
  {% endfor %}

  <div class="cat_h">
    <h2>{{ section.settings.heading }}</h2>
  </div>
</div>

{% schema %}
{
  "name": "portfolio category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "id": "image",
          "label": "Image",
          "type": "image_picker"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portfolio Category"
    }
  ]
}
{% endschema %}
