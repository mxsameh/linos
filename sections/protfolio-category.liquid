<div class="category">
  {% for block in section.blocks %}
    <figure>
      <img
        src="{{ block.settings.image | image_url}}"
        width="auto"
        height="auto"
      >
    </figure>
  {% endfor %}

  <h2>{{ section.settings.heading }}</h2>
</div>

{% schema %}
{
  "name": "portfolio category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "id": "image",
          "label": "Image",
          "type": "image_picker"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portfolio Category"
    }
  ]
}
{% endschema %}
