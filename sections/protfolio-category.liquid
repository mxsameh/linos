<script>
  const images = [
    {% assign has_image = false %}

    {% for block in section.blocks %}
      {% if block.settings.image %}
        {% if has_image %},{% endif %}
        {{ block.settings.image | image_url: width: 1200 | json }}
        {% assign has_image = true %}
      {% endif %}
    {% endfor %}
  ];

  console.log(images);
</script>

<div class="category">
  <figure>
    <img />
  </figure>
  <figure>
    <img />
  </figure>
  <figure>
    <img />
  </figure>

  {% comment %}
    {% for block in section.blocks %}
      <figure>
        <img
          src="{{ block.settings.image | image_url}}"
          width="auto"
          height="auto"
        >
      </figure>
    {% endfor %}
  {% endcomment %}

  <div class="cat_h">
    <h2>{{ section.settings.heading }}</h2>
    <button class="btn">change</button>
  </div>
</div>

{% schema %}
{
  "name": "portfolio category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "id": "image",
          "label": "Image",
          "type": "image_picker"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portfolio Category"
    }
  ]
}
{% endschema %}
