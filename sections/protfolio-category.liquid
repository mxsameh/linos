{% comment %}
  <script>
    const imgs=[]
    {% for block in section.blocks %}
      const s = {{ block.settings.image | image_url | json }};
           imgs.push(s);
      {% endfor %}
  </script>
{% endcomment %}

<script>
  const images = [
    {% for block in section.blocks %}
        {% if block.settings.image %}
          {{ block.settings.image | image_url: width: 1200 | json }}
        {% else %}
          null
        {% endif %}
      {% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  console.log(images);
</script>

<div class="category">
  <figure>
    <img
    >
  </figure>
  <figure>
    <img
    >
  </figure>
  <figure>
    <img
      src="{{ block.settings.image | image_url}}"
      width="auto"
      height="auto"
    >
  </figure>

  {% comment %}
    {% for block in section.blocks %}
      <figure>
        <img
          src="{{ block.settings.image | image_url}}"
          width="auto"
          height="auto"
        >
      </figure>
    {% endfor %}
  {% endcomment %}

  <div class="cat_h">
    <h2>{{ section.settings.heading }}</h2>
  </div>
</div>

{% schema %}
{
  "name": "portfolio category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "id": "image",
          "label": "Image",
          "type": "image_picker"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portfolio Category"
    }
  ]
}
{% endschema %}
