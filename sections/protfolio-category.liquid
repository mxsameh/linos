<div class="category">
  <figure>
    <img />
  </figure>
  <figure>
    <img />
  </figure>
  <figure>
    <img />
  </figure>

  <div class="cat_h">
    <h2>{{ section.settings.heading }}</h2>
    <button class="prev">prev</button>
    <button class="next">next</button>
  </div>
</div>

<script>
  (() => {

    const section = document.querySelector(
      '#category-{{ section.id }}'
    );

    const images = [
      {% assign has_image = false %}

      {% for block in section.blocks %}
        {% if block.settings.image %}

          {% if has_image %},{% endif %}

          {{ block.settings.image
            | image_url: width: 1200
            | json
          }}

          {% assign has_image = true %}

        {% endif %}
      {% endfor %}
    ];

    const imageElements = section.querySelectorAll(
      'figure img'
    );

    const nextButton = section.querySelector('.next');
    const prevButton = section.querySelector('.prev');

    let currentIndex = 0;


    // Preload images
    images.forEach(src => {
      const img = new Image();
      img.src = src;
    });


    function updateImages() {

      imageElements.forEach((img, i) => {

        const index =
          (currentIndex + i) % images.length;

        img.src = images[index];

      });

    }


    nextButton.addEventListener('click', () => {

      currentIndex =
        (currentIndex + 3) % images.length;

      updateImages();

    });


    prevButton.addEventListener('click', () => {

      currentIndex =
        (currentIndex - 3 + images.length)
        % images.length;

      updateImages();

    });


    updateImages();

  })();
</script>

{% schema %}
{
  "name": "portfolio category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "id": "image",
          "label": "Image",
          "type": "image_picker"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portfolio Category"
    }
  ]
}
{% endschema %}
