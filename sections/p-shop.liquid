{{ 's-p-about.css' | asset_url | stylesheet_tag }}

{% assign collection = collections.all %}

<div class="p">
  <h1>SHOP</h1>
  {{ collection.all_tags | json }}

  {% for tag in collection.all_tags %}
    <a
      href="{{ collection.url }}/{{ tag | handleize }}"
      class="{% if current_tags contains tag %}active{% endif %}"
    >
      {{ tag }}
    </a>
  {% endfor %}

  {% for product in collection.products %}
    {% if product.tags contains 'Black' %}
      <h3>{{ product.title }}</h3>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "shop",
  "settings": []
}
{% endschema %}
