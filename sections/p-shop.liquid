{{ 's-p-about.css' | asset_url | stylesheet_tag }}

{% comment %}
  {% assign collection = collections.all %}
{% endcomment %}

<div class="p">
  <h1>SHOP</h1>

  <div class="shop-page">
    <header class="shop-header">
      <h1>{{ page.title }}</h1>

      <div class="shop-filters" data-filters>
        <button
          type="button"
          class="shop-filter is-active"
          data-filter="all"
        >
          All
        </button>

        {% assign shop_tags = 'floral,berries,Birthday' | split: ',' %}

        {% for tag in shop_tags %}
          <button
            type="button"
            class="shop-filter"
            data-filter="{{ tag | handleize }}"
          >
            {{ tag }}
          </button>
        {% endfor %}
      </div>
    </header>

    <main class="shop-products">
      {% for product in collections.all.products %}
        {% assign product_tags = product.tags | join: ',' | handleize | split: ',' %}

        <article
          class="product-card"
          data-product-tags="{{ product_tags | join: ' ' }}"
        >
          <a href="{{ product.url }}" class="product-card__link">
            <div class="product-card__image">
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '400,600,800',
                    sizes: '(min-width: 750px) 25vw, 50vw',
                    alt: product.featured_image.alt
                }}
              {% endif %}
            </div>

            <div class="product-card__info">
              <h2 class="product-card__title">
                {{ product.title }}
              </h2>

              <span class="product-card__price">
                {{ product.price | money }}
              </span>
            </div>
          </a>
        </article>
      {% endfor %}
    </main>

  </div>
</div>

{% schema %}
{
  "name": "shop",
  "settings": []
}
{% endschema %}
