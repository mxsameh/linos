{{ 's-p-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'j-shop.js' | asset_url }}" defer="defer"></script>

{% assign shop_tags = 'floral,berries,birthday' | split: ',' %}

<div class="p">
  <h1>SHOP</h1>

  <h1>{{ page.title }}</h1>

  <div class="shop-filters" data-filters>
    <button
      type="button"
      class="shop-filter is-active"
      data-filter="all"
    >
      All
    </button>

    {% for tag in shop_tags %}
      <button
        type="button"
        class="shop-filter"
        data-filter="{{ tag | handleize }}"
      >
        {{ tag }}
      </button>
    {% endfor %}
  </div>

  <main class="shop-products">
    {% for product in collections.all.products %}
      {% assign product_tags = product.tags | join: ',' | handleize | split: ',' %}
      <article
        class="product-card"
        data-product-tags="{{ product_tags | join: ' ' }}"
      >
        {% render 'product-card', product: product %}
      </article>
    {% endfor %}
  </main>
</div>

{% schema %}
{
  "name": "shop",
  "settings": []
}
{% endschema %}
