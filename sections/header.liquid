{{ 's-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'j-header.js' | asset_url }}" defer="defer"></script>

<div class="h_">
  <div class="h-ph"></div>

  <header id="h" class="h">
    <!-- Header Left -->
    <div class="h_l">
      <a class="h_logo" href=''>
        {{ 'i-logo.svg' | inline_asset_content }}
      </div>
    </a>

    <!-- Header Right -->
    <div class="h_r">
      {% render 'menu-icon' %}
      <nav class="h_n">
        {% for link in linklists['main-menu'].links -%}
          <div class="h_n-item">
            {{ link.title | link_to: link.url }}

            <!-- Dropdown Menu -->
            {% if link.links.size > 0 %}
              {% render 'dropdown-menu', links: link.links %}
            {% endif %}
          </div>
        {%- endfor %}
      </nav>
      <button id="cart-btn" class="h_cb" type="button">
        BAG (<span id="cart-count" class="h_cb_count">{{- cart.item_count -}}</span>)
      </button>
    </div>

    <div class="h_r-m">
      <div id="search-btn">
        {{ 'i-search.svg' | inline_asset_content }}
      </div>
      <div id="cart-btn">
        {{ 'i-bag.svg' | inline_asset_content }}
        <div class="h_r-m_cc" id="cart-count">{{- cart.item_count -}}</div>
      </div>
    </div>
  </header>

  <!-- MENU DRAWER -->
  {% render 'menu-drawer' %}

  <!-- SEARCH MODAL -->
  {% render 'search-modal' %}
</div>

{% schema %}
{
  "name": "header",
  "settings": []
}
{% endschema %}
