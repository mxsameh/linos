{{ 's-p-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'j-product.js' | asset_url }}" defer></script>
<script src="{{ 'j-accordion.js' | asset_url }}" defer></script>

{% liquid
  assign current_variant = product.selected_or_first_available_variant
%}

<div class="p">
  <h1 class="product_title">{{ product.title }}</h1>
  {% render 'product-gallery' %}

  <div class="product_info">
    <div class="l">
      {% render 'product-form' %}
    </div>

    <div class="c">
      {% if product.description %}
        <p class="product_desc">
          {{ product.description | strip_html }}
        </p>
      {% endif %}
    </div>

    <div class="r">
      <div class="product_preorder">
        Preorder: 
        {{ product.metafields.custom.preorder }}
      </div>
      <div class="product_price">
        <span>{{ current_variant.price | money_without_currency | remove: '.00' }}</span>
        {{ shop.currency }}
      </div>
      {% comment %}
        Add to Cart
      {% endcomment %}
      <div class="product_atc">
        {% if available %}
          <button
            type="submit"
          >
            Add to Bag
          </button>
        {% else %}
          <button
            type="submit"
            disabled
            class="disabled"
          >
            Sold Out
          </button>
        {% endif %}
      </div>
    </div>
  </div>

  {% render 'recommended-products' %}
</div>

<script>
  const product = {{ product | json }};
</script>

{% schema %}
{
  "name": "product",
  "settings": []
}
{% endschema %}
